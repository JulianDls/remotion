# Esta intro NO necesita ninguna API key: la voz (Supertonic 3), la música y las imágenes
# se generan localmente. Las variables siguientes son opcionales.

# Ruta a un Chrome/Chromium propio para renderizar (si no, Remotion descarga Chrome Headless Shell).
# REMOTION_BROWSER_EXECUTABLE=/ruta/a/chrome

# Número de fotogramas renderizados en paralelo (por defecto, la mitad de los núcleos).
# RENDER_CONCURRENCY=4

# Escala de los fondos al regenerarlos con scripts/generate_plates.py (1 = 3200x1800; 0.5 = prueba rápida).
# PLATE_SCALE=1
